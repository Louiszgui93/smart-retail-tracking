# IA Varejo - Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores

# Banco de Dados
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=person_tracking_db
DB_PORT=3306

# Câmera RTSP
RTSP_URL=rtsp://usuario:senha@ip_camera:porta/caminho
CAMERA_ID=cam_entrada

# Modelo YOLO e Tracking
YOLO_MODEL=yolov8n_openvino_model
TRACKER_CONFIG=config/bytetrack.yaml
TARGET_WIDTH=960

# Google Vision API (Opcional)
GOOGLE_APPLICATION_CREDENTIALS=config/vision_service_account.json

# Sistema
LOG_LEVEL=INFO
CACHE_TTL_MINUTES=120
CONFIRMATION_FRAMES=3
ZONE_ALERT_THRESHOLD=60

# Dashboard
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False

# Reidentificação
SIMILARITY_THRESHOLD=0.55
MIN_DETECTION_CONFIDENCE=0.4
